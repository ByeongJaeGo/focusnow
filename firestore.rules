rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}
    //   id, name, passwordHash, createdAt
    //   lastLoginAt?
    //   signupOrder?, goldenFlower? (new signups)
    //   streak7Order?, rainbowAura?, streak7At? (first 100 to hit 7-day streak)
    //
    // Collection: meta/signup { count }
    // Collection: meta/streak7 { count }
    // ===============================================================

    function isValidUserId(userId) {
      return userId is string
        && userId.size() >= 3
        && userId.size() <= 40
        && userId.matches('^[a-z0-9_]+$');
    }

    function hasBaseUserFields(data) {
      return data.keys().hasAll(['id', 'name', 'passwordHash', 'createdAt'])
        && data.id is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.passwordHash is string
        && data.passwordHash.size() == 64
        && data.createdAt is string
        && (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    function hasGoldenFields(data) {
      return data.keys().hasAll(['signupOrder', 'goldenFlower'])
        && data.signupOrder is int
        && data.signupOrder >= 1
        && data.goldenFlower is bool
        && data.goldenFlower == (data.signupOrder <= 50);
    }

    function isValidNewUser(data) {
      return hasBaseUserFields(data) && hasGoldenFields(data);
    }

    function goldenFieldsUnchanged() {
      return (
        (!('signupOrder' in resource.data)
          && !('signupOrder' in request.resource.data)
          && !('goldenFlower' in request.resource.data))
        || (
          'signupOrder' in resource.data
          && 'goldenFlower' in resource.data
          && request.resource.data.signupOrder == resource.data.signupOrder
          && request.resource.data.goldenFlower == resource.data.goldenFlower
        )
      );
    }

    function hasValidRainbowClaim(data) {
      return data.rainbowAura == true
        && data.streak7Order is int
        && data.streak7Order >= 1
        && data.streak7Order <= 100
        && data.streak7At is string;
    }

    function rainbowFieldsOk() {
      // Already claimed: immutable
      if ('rainbowAura' in resource.data) {
        return request.resource.data.rainbowAura == resource.data.rainbowAura
          && request.resource.data.streak7Order == resource.data.streak7Order
          && (
            (!('streak7At' in resource.data) && !('streak7At' in request.resource.data))
            || request.resource.data.streak7At == resource.data.streak7At
          );
      }
      // Not claiming rainbow this update
      if (!('rainbowAura' in request.resource.data)
        && !('streak7Order' in request.resource.data)
        && !('streak7At' in request.resource.data)) {
        return true;
      }
      // First-time claim
      return hasValidRainbowClaim(request.resource.data);
    }

    match /users/{userId} {
      allow get: if isValidUserId(userId);
      allow list: if false;

      allow create: if isValidUserId(userId)
        && isValidNewUser(request.resource.data)
        && request.resource.data.id == userId
        && !('lastLoginAt' in request.resource.data)
        && !('rainbowAura' in request.resource.data)
        && !('streak7Order' in request.resource.data)
        && !('streak7At' in request.resource.data);

      allow update: if isValidUserId(userId)
        && hasBaseUserFields(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.passwordHash == resource.data.passwordHash
        && request.resource.data.createdAt == resource.data.createdAt
        && goldenFieldsUnchanged()
        && rainbowFieldsOk()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastLoginAt', 'name', 'rainbowAura', 'streak7Order', 'streak7At']);

      allow delete: if false;
    }

    match /meta/{docId} {
      allow get: if docId == 'signup' || docId == 'streak7';
      allow list: if false;

      allow create: if (docId == 'signup' || docId == 'streak7')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;

      allow update: if (docId == 'signup' || docId == 'streak7')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }
  }
}
